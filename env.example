# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Resend email
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="World Mosaic <hello@yourdomain.com>"
RESEND_FROM_NAME="World Mosaic"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="generate-a-long-random-string-here"
SESSION_SECRET="another-long-random-string"

# Cron (for scheduled reminders)
CRON_SECRET="cron-secret-string"

# Optional image storage
IMAGE_STORAGE_PROVIDER="cloudinary"   # or vercel-blob / uploadthing
IMAGE_STORAGE_API_KEY=""
IMAGE_STORAGE_BASE_URL=""
